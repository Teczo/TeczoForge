# Copy this file to .env and change values if needed.

# Port the backend listens on (always on 127.0.0.1).
PORT=4000

# Where ComfyUI is running. Only the backend talks to it.
COMFYUI_URL=http://127.0.0.1:8188

# MongoDB Atlas connection string, from the Atlas "Connect" button.
# This is a secret: put the real value only in backend/.env, never in git.
# Leave empty to run without job history (images still work).
# Team accounts are stored here too, so logging in needs MongoDB.
MONGODB_URI=

# Secret key that signs login cookies. A long random text, at least 32 characters. Keep it secret.
# Make one:  cd backend, then  npm run secret  (prints 64 hex characters). Paste it after the = sign.
# If it is empty, everyone is logged out each time the backend restarts.
SESSION_SECRET=
