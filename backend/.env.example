# Copy this file to .env and change values if needed.

# Port the backend listens on (always on 127.0.0.1).
PORT=4000

# Where ComfyUI is running. Only the backend talks to it.
COMFYUI_URL=http://127.0.0.1:8188

# MongoDB Atlas connection string, from the Atlas "Connect" button.
# This is a secret: put the real value only in backend/.env, never in git.
# Leave empty to run without job history (images still work).
# Team accounts are stored here too, so logging in needs MongoDB.
MONGODB_URI=

# Secret key that signs login cookies. A long random text, at least 32 characters. Keep it secret.
# Make one:  cd backend, then  npm run secret  (prints 64 hex characters). Paste it after the = sign.
# If it is empty, everyone is logged out each time the backend restarts.
SESSION_SECRET=

# Chat page (FRG-23). The chat text goes to the Claude API on the internet; generation stays on this PC.
# API key from https://platform.claude.com (API keys). This is a secret: only in backend/.env, never in git.
# Leave empty to turn chat off: the chat page then says "Chat is not set up". Everything else still works.
ANTHROPIC_API_KEY=
# The Claude model for chat. Current models (October 2026): claude-opus-5-5 (the most capable Opus),
# claude-sonnet-5-5 (faster, cheaper), claude-haiku-4-5 (fastest, cheapest).
CLAUDE_MODEL=claude-opus-5-5
# Optional: the most tokens (input + output) one user may use per day. Empty: no limit.
CHAT_DAILY_TOKEN_LIMIT=
