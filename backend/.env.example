# Copy this file to .env and change values if needed.

# Port the backend listens on (always on 127.0.0.1).
PORT=4000

# Where ComfyUI is running. Only the backend talks to it.
COMFYUI_URL=http://127.0.0.1:8188

# MongoDB Atlas connection string, from the Atlas "Connect" button.
# This is a secret: put the real value only in backend/.env, never in git.
# Leave empty to run without job history (images still work).
# Team accounts are stored here too, so logging in needs MongoDB.
MONGODB_URI=

# Secret key that signs login cookies. A long random text, at least 32 characters. Keep it secret.
# Make one:  cd backend, then  npm run secret  (prints 64 hex characters). Paste it after the = sign.
# If it is empty, everyone is logged out each time the backend restarts.
SESSION_SECRET=

# Chat page (FRG-23). The chat text goes to the Claude API on the internet; generation stays on this PC.
# API key from https://platform.claude.com (API keys). This is a secret: only in backend/.env, never in git.
# Leave empty to turn chat off: the chat page then says "Chat is not set up". Everything else still works.
ANTHROPIC_API_KEY=
# The Claude model for chat. Current models (October 2026): claude-opus-5-5 (the most capable Opus),
# claude-sonnet-5-5 (faster, cheaper), claude-haiku-4-5 (fastest, cheapest).
CLAUDE_MODEL=claude-opus-5-5
# Optional: the most tokens (input + output) one user may use per day. Empty: no limit.
CHAT_DAILY_TOKEN_LIMIT=

# Full path to ffmpeg.exe (FRG-53). Used to take the last frame of a video.
# Example: C:\ffmpeg\bin\ffmpeg.exe   Leave empty to turn this off.
FFMPEG_PATH=

# Where "Export to Unity folder" writes a game (FRG-70): {GAME_EXPORT_DIR}\{CODE}_Assets\.
# Leave empty for data\exports in the repo. Example: D:\UnityExports
# The export only writes and overwrites files. It never deletes anything in this folder.
GAME_EXPORT_DIR=

# Where "Export" on a pack page writes a pack (FRG-82): {PACK_EXPORT_DIR}\{CODE}_Forge\.
# Leave empty for data\exports in the repo. Example: D:\ForgeExports
# The export only writes and overwrites files. It never deletes anything in this folder.
PACK_EXPORT_DIR=

# The folder that holds ALL model files: ComfyUI's models and the translate model.
# Inside it are ComfyUI's usual subfolders (diffusion_models, text_encoders, vae, loras, ...)
# and llm\ for the translate model. start-teczoforge.bat points ComfyUI to this folder.
# Leave empty for the models folder in the repo (TeczoAIGenerator\models).
# To keep the models on an external drive, move the folder there and set it, for example:
# MODELS_DIR=E:\TeczoForgeModels
MODELS_DIR=

# Japanese translation (FRG-90, plan: docs/japanese-translate.md). It runs on this PC only.
# Full path to llama-server.exe. Example: C:\llama.cpp\llama-server.exe
# Empty: the feature is off. The page says "Translation is not set up".
LLAMA_SERVER_PATH=
# The main model file. A path inside MODELS_DIR, or a full path (C:\...) to a file anywhere.
# Example: llm\qwen3.8-27b\Qwen3.8-27B-UD-Q5_K_M.gguf
TRANSLATE_MODEL_PATH=
# The vision file. A path inside MODELS_DIR, or a full path.
# Example: llm\qwen3.8-27b\mmproj-BF16.gguf
TRANSLATE_MMPROJ_PATH=
# Port for llama-server (always on 127.0.0.1). Only the backend talks to it.
TRANSLATE_PORT=8190
# Lowest number of image tokens per photo.
TRANSLATE_IMAGE_MIN_TOKENS=2048
# Highest number of image tokens per photo.
TRANSLATE_IMAGE_MAX_TOKENS=8192
# Context size for llama-server.
TRANSLATE_CONTEXT=24576
# The language to translate into.
TRANSLATE_TARGET_LANGUAGE=English
